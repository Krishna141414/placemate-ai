# PlaceMate configuration. Copy this file to `.env` and fill in what you need.
# The app runs with no changes at all: without a Gemini key it falls back to the
# local model, and without that to extractive answers.

# --- App ---
APP_ENV=development
# Signing key for the session cookie. Leave the placeholder for local use: a
# random key is then generated once into backend/storage/ (not committed).
# In production (APP_ENV=production) a real value is mandatory. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480
# Set to true when serving over HTTPS so the auth cookie is marked Secure.
COOKIE_SECURE=false

# --- Network ---
# The only origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Storage ---
# Leave empty to use SQLite at backend/storage/placemate.db (recommended).
DATABASE_URL=

# --- LLM provider: gemini | local | extractive ---
# Fallback order is always gemini -> local -> extractive.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Retrieval models (read from the Hugging Face cache) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Limits ---
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
PROBE_RATE_LIMIT_PER_MINUTE=5
MAX_UPLOAD_MB=5

# --- Frontend (read by Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
