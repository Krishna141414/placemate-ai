{
  "name": "placemate-ai",
  "private": true,
  "description": "PlaceMate: AI placement copilot. Root scripts wrap the PowerShell helpers in scripts/.",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "reset-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-demo.ps1",
    "test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "eval": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/eval.ps1"
  }
}
